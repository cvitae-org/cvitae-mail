# cvitae-mail — the mailbox, in a process of its own.
#
# Nothing here is needed to start. Without an OAuth client the service runs and
# answers /health with `not_configured`, which is the state cvitae-agent-runtime
# is written to expect.

# --- The Google OAuth client -------------------------------------------------
#
# Create it at https://console.cloud.google.com/apis/credentials, in a project
# with the Gmail API enabled. Application type must be **Desktop app**: Google
# permits loopback redirects for that type and refuses them for a web
# application, and the loopback redirect is the whole flow here.
#
# A desktop client secret is not really a secret — it ships with the app, and
# Google says so. It is still worth keeping out of git, which .gitignore does.
GMAIL_CLIENT_ID=
GMAIL_CLIENT_SECRET=

# --- What this service is allowed to do --------------------------------------
#
# Off by default, and this is the setting to think about rather than skip.
#
# With sending off, the only outbound operation is POST /draft: the message
# appears in Gmail's Drafts folder and a human presses Send. No bug, no bad model
# output, and no instruction hidden in a scraped job offer can put a message in
# front of another person. Switching this on removes that property.
MAIL_ALLOW_SEND=false

# Reading grants `gmail.readonly`, which is the whole mailbox — Google has no
# scope for "only the messages matching this query". Set it to false to hold a
# token that cannot read mail at all. Changing it requires reconnecting, since
# scopes are fixed at consent.
MAIL_ALLOW_READ=true

# A development guard, not a production control. Comma-separated; an entry
# beginning with @ matches a whole domain. Empty means no restriction, which is
# what real use needs — applications go to arbitrary recruiters. While wiring
# this up it is the difference between finding a mistake in your own inbox and
# finding it in someone else's.
#
# MAIL_ALLOWED_RECIPIENTS=me@example.com,@my-own-domain.com

# --- Where it listens and what it keeps --------------------------------------
#
# The port is part of the OAuth redirect URI, so changing it means changing what
# is registered on the Google client. The host is fixed at 127.0.0.1 and is not
# configurable: this holds a live mailbox credential and has no authentication.
PORT=8789

# Separate from the runtime's ~/.cvitae on purpose — two processes holding two
# different secrets in one directory is harder to reason about and easier to
# lose to a stray chmod.
# MAIL_HOME=~/.cvitae-mail

# LOG_LEVEL=info
# ENV_FILE=.env
